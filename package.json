{
  "name": "github-analyser",
  "version": "1.0.0",
  "description": "CLI tool to evaluate developers based on GitHub contributions and generate HTML scorecard reports",
  "main": "index.js",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "bin": {
    "github-analyser": "./index.js"
  },
  "scripts": {
    "start": "node index.js",
    "analyse": "node index.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "lint": "eslint src/"
  },
  "keywords": [
    "github",
    "developer",
    "scorecard",
    "analysis",
    "code-quality",
    "cli"
  ],
  "license": "MIT",
  "dependencies": {
    "octokit": "^4.1.0",
    "tree-sitter": "^0.21.1",
    "tree-sitter-javascript": "^0.23.0",
    "tree-sitter-php": "^0.23.12",
    "tree-sitter-typescript": "^0.23.2"
  },
  "devDependencies": {
    "jest": "^30.2.0"
  }
}
